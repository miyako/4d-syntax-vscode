{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "4D",
  "patterns": [
    {
      "match": "^//\\s*%attributes.*$",
      "name": "meta.attributes.4d"
    },
    {
      "match": "\\\\\\s*$",
      "name": "constant.character.escape.line-continuation.4d"
    },
    {
      "begin": "/\\*",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.4d"
        }
      },
      "end": "\\*/",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.4d"
        }
      },
      "name": "comment.block.4d",
      "patterns": []
    },
    {
      "begin": "\\s*+(\\/\\/)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.comment.4d"
        }
      },
      "end": "(?<=\\n)(?<!\\\\\\n)",
      "name": "comment.line.double-slash.4d",
      "patterns": []
    },
    {
      "comment": "4D requires End SQL alone on its line (no trailing comment), so the raw body cannot false-terminate on text that merely contains \"End SQL\".",
      "begin": "(?i:\\b(begin sql|debut sql)\\b)",
      "beginCaptures": {
        "0": {
          "name": "keyword.other.sql-block.4d"
        }
      },
      "end": "(?i:^\\s*(end sql|fin sql)\\s*$)",
      "endCaptures": {
        "0": {
          "name": "keyword.other.sql-block.4d"
        }
      },
      "name": "meta.embedded.block.sql.4d",
      "patterns": []
    },
    {
      "match": "(?<!\\w|:)[0-9]+\\b",
      "name": "constant.numeric.4d"
    },
    {
      "match": "(?<!\\w)[0-9]+[.,][0-9]+\\b",
      "name": "constant.numeric.decimal.4d"
    },
    {
      "match": "(?<!\\w)[0-9]+[.,][0-9]+[eE]-?[0-9]+\\b",
      "name": "constant.numeric.exponential.4d"
    },
    {
      "match": "(?<!\\w)0[xX][0-9a-fA-F]+\\b",
      "name": "constant.numeric.hexadecimal.4d"
    },
    {
      "match": "(?<!\\w)[?][0-9]{2,3}:[0-9]{2}:[0-9]{2}[?]\\b",
      "name": "constant.other.time.4d"
    },
    {
      "comment": "Both delimiters must match: '-' (ISO), '/' or '.' (regional system settings).",
      "match": "(?<!\\w)[!]([0-9]{1,4})([-/.])([0-9]{1,4})\\2([0-9]{1,4})[!]\\b",
      "name": "constant.other.date.4d"
    },
    {
      "match": "(?<!\\w)([\\p{Letter}_0-9])([\\p{Letter}_ 0-9])+([\\p{Letter}_0-9])(:K[0-9]+:[0-9]+)\\b",
      "name": "support.constant.4d"
    },
    {
      "match": "(?<=[\"])((\\\\[\"ntr\\\\])|[^\"])*(?=[\"])",
      "name": "string.quoted.double.4d"
    },
    {
      "match": "\\[\\[|\\]\\]",
      "name": "punctuation.definition.char-reference.4d"
    },
    {
      "match": "(?<!\\w)\\[([\\p{Letter}_0-9])([\\p{Letter}_0-9 ])*(:[0-9]+)?\\]([\\p{Letter}_0-9])([\\p{Letter}_0-9 ])*(:[0-9]+)?",
      "name": "variable.other.property.4d"
    },
    {
      "comment": "Bare [Table:1] with no trailing field name.",
      "match": "(?<!\\w)\\[([\\p{Letter}_0-9])([\\p{Letter}_0-9 ])*:[0-9]+\\](?![\\p{Letter}_0-9])",
      "name": "support.class.4d"
    },
    {
      "match": "(?<!\\w)[$][0-9]+\\b",
      "name": "variable.parameter.numeric.4d"
    },
    {
      "match": "[$][{]",
      "name": "punctuation.definition.variable.indirection.4d"
    },
    {
      "match": "(?<!\\w)[$]([\\p{Letter}_]+)([\\p{Letter}_0-9]*)+\\b",
      "name": "variable.other.local.4d"
    },
    {
      "match": "(?<!\\w)<>([\\p{Letter}_]+)([\\p{Letter}_0-9]*)+\\b",
      "name": "variable.other.interprocess.4d"
    },
    {
      "match": "(?<=\\.)([\\p{Letter}])([\\p{Letter}0-9])*(?=\\()",
      "name": "entity.name.function.4d"
    },
    {
      "match": "(?<=\\.)([\\p{Letter}])([\\p{Letter}0-9])*\\b",
      "name": "variable.other.property.4d"
    },
    {
      "match": "(?<!\\w)([\\p{Letter}_0-9])([\\p{Letter}_ 0-9])*([\\p{Letter}_0-9])(:C[0-9]+)\\b",
      "name": "support.function.4d"
    },
    {
      "match": "(?<!\\w)_[oO]_([cC]_)?([\\p{Letter} ])+([\\p{Letter}])(:C[0-9]+)\\b",
      "name": "support.function.deprecated.4d"
    },
    {
      "match": "(?<!\\w)([cC]_)([\\p{Letter}])+(:C[0-9]+)\\b",
      "name": "support.type.4d"
    },
    {
      "match": "(?<!\\w)(?i)(super|this|form|null|4d|ds|cs)(?=(:C[0-9]+)?)\\b",
      "name": "variable.language.4d"
    },
    {
      "match": "\\b(?i:try)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:catch)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end try)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "(?<!\\w)(?i)(#DECLARE)\\b",
      "name": "keyword.control.directive.4d"
    },
    {
      "match": "\\b(?i:alias )([\\p{Letter}]+ )([\\p{Letter}\\.]*)([\\p{Letter}]+)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "\\b(?i)((?:shared |session |singleton |exposed |local |server |onHTTPGet )*)(function )(?:(get|set|event|query|orderBy) )?([\\p{Letter}_][\\p{Letter}_0-9]*)?\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.4d"
        },
        "2": {
          "name": "keyword.other.4d"
        },
        "3": {
          "name": "keyword.other.4d"
        },
        "4": {
          "name": "entity.name.function.4d"
        }
      }
    },
    {
      "match": "\\b(?i:return)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:break)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:continue)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:throw)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:defer)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end use)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "\\b(?i:fin utiliser)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "\\b(?i:case of)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:au cas ou)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end case)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:fin de cas)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:if)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:si)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:else)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:sinon)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:fin de si)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:boucle)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:fin de boucle)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:repeat)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:repeter)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:until)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:jusque)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:while)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:tant que)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end while)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:fin tant que)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:pour chaque)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end for each)\\b",
      "name": "keyword.control.4d",
      "comment": "must come after end for each"
    },
    {
      "match": "\\b(?i:end for)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:for each)\\b",
      "name": "keyword.control.4d",
      "comment": "must come after for each"
    },
    {
      "match": "\\b(?i:for)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:end if)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i:fin de chaque)\\b",
      "name": "keyword.control.4d"
    },
    {
      "match": "\\b(?i)((?:shared |session |singleton |exposed |local |server |onHTTPGet )*)(class constructor)\\b",
      "captures": {
        "1": {
          "name": "storage.modifier.4d"
        },
        "2": {
          "name": "keyword.other.4d"
        }
      }
    },
    {
      "match": "\\b(?i:class extends)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "(?<= : )([\\p{Letter}])([\\p{Letter}0-9]*)\\b",
      "name": "support.type.4d"
    },
    {
      "match": "\\b(?i:property)\\b",
      "name": "storage.type.4d"
    },
    {
      "match": "\\b(?i:var)\\b",
      "name": "storage.type.4d"
    },
    {
      "match": "\\b(?i:use)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "\\b(?i:utiliser)\\b",
      "name": "keyword.other.4d"
    },
    {
      "match": "\\b(?i:error method)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:error line)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:error formula)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:error)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:mousedown)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:mouseproc)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:mouse[xy])\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:keycode)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:modifiers)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:flddelimit)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:recdelimit)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:ok)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\b(?i:document)\\b",
      "name": "support.variable.classic.4d"
    },
    {
      "match": "\\.\\.\\.",
      "name": "keyword.operator.variadic.4d"
    },
    {
      "match": ":=|\\+=|\\-=|\\*=|\\/=|\\^\\||\\|\\||&&|<<|>>|<=|>=|\\?\\?|\\?\\+|\\?\\-|->|\\+|\\-|\\*|\\/|=|#|<|>|&|\\||%|\\\\|\\^|\\?|:",
      "name": "keyword.operator.4d"
    }
  ],
  "scopeName": "source.4dm"
}
